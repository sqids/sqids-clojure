{:paths
 ["src" "resources"]

 :deps
 {}

 :aliases
 {:clj
  {:extra-deps
   {org.clojure/clojure {:mvn/version "1.12.6"}}}

  :cljs
  {:extra-deps
   {thheller/shadow-cljs {:mvn/version "3.5.7"}}}

  :dev
  {:extra-paths
   ["dev" "test"]

   :extra-deps
   {org.clojure/data.json  {:mvn/version "2.5.2"}
    org.clojure/test.check {:mvn/version "1.1.3"}}}

  :test
  {:extra-deps
   {org.clojure/clojurescript    {:mvn/version "1.12.145"}
    lambdaisland/kaocha           {:mvn/version "1.91.1392"}
    com.lambdaisland/kaocha-cljs  {:mvn/version "1.9.181"}
    lambdaisland/kaocha-junit-xml {:mvn/version "1.17.101"}
    lambdaisland/kaocha-cloverage {:mvn/version "1.1.89"}}
   :main-opts ["-m" "kaocha.runner"]}

  :cljstyle
  {:replace-deps {mvxcvi/cljstyle {:mvn/version "0.17.642"}}
   :main-opts    ["-m" "cljstyle.main"]}

  :clj-kondo
  {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
   :main-opts    ["-m" "clj-kondo.main"]}

  :build
  {:replace-deps
   {io.github.clojure/tools.build {:mvn/version "0.10.14"}
    slipset/deps-deploy           {:mvn/version "0.2.5"}}

   :ns-default
   build}

  :nrepl
  {:extra-deps {nrepl/nrepl {:mvn/version "1.8.0"}}
   :main-opts  ["-m" "nrepl.cmdline" "--interactive" "--color"]}}}
